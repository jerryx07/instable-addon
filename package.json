{
  "name": "sound-addon",
  "version": "2.0.0",
  "private": true,
  "description": "Instable-first lossless music addon for PureBits with Monochrome fallback",
  "type": "commonjs",
  "scripts": {
    "start": "node --env-file-if-exists=.env addon/server.js",
    "dev": "node --watch --env-file-if-exists=.env addon/server.js",
    "doctor": "node --env-file-if-exists=.env addon/doctor.js",
    "test": "node --test addon/test/*.test.js"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "license": "Apache-2.0"
}
